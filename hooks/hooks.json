{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Edit|Write|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard.js\"",
            "timeout": 10,
            "statusMessage": "third-rail: checking sensitive paths"
          }
        ]
      }
    ]
  }
}
