#!/usr/bin/env node
/*
 * third-rail-route-map <dir>
 *
 * Deterministic Express route and middleware mapper. Scans .js files and emits
 * JSON: parser mounts (and their order), router mounts with prefixes, routes
 * with their per-route middleware chains.
 *
 * Design stance: this script computes facts; the blast-radius agent interprets
 * them. It is regex-based on purpose, so the plugin stays zero-dependency. The
 * cost of that choice is stated in the "limitations" field of every output,
 * because a map that hides its own blind spots is worse than no map.
 *
 * Everything emitted is sorted by source position within its file. Mount order
 * is the subject of two runbook items, so an array whose order does not match
 * the source would be worse than no array at all.
 */

'use strict';

const fs = require('fs');
const path = require('path');

const SKIP_DIRS = new Set(['node_modules', '.git', 'dist', 'build', 'coverage']);
const ROUTE_RE = /\b(app|router)\.(get|post|put|patch|delete|all)\s*\(\s*(['"`])([^'"`]*)\3\s*(,)?/g;
const USE_RE = /\b(app|router)\.use\s*\(/g;
const PARSER_RE = /\bexpress\.(json|raw|urlencoded|text)\s*\(/g;
const REQUIRE_NAME_RE = /(?:const|let|var)\s+([A-Za-z_$][\w$]*)\s*=\s*require\s*\(\s*(['"])(\.[^'"]*)\2\s*\)/g;

function listJsFiles(dir, out = []) {
  let entries;
  try {
    entries = fs.readdirSync(dir, { withFileTypes: true });
  } catch {
    return out;
  }
  for (const entry of entries) {
    if (entry.name.startsWith('.') && entry.name !== '.') continue;
    const full = path.join(dir, entry.name);
    if (entry.isDirectory()) {
      if (!SKIP_DIRS.has(entry.name)) listJsFiles(full, out);
    } else if (entry.isFile() && entry.name.endsWith('.js')) {
      out.push(full);
    }
  }
  return out;
}

function lineOf(source, index) {
  return source.slice(0, index).split('\n').length;
}

function stripComments(src) {
  // Blank out comments while preserving every newline, so lineOf() stays true.
  let out = src.replace(/\/\*[\s\S]*?\*\//g, (m) => m.replace(/[^\n]/g, ' '));
  out = out.replace(/(^|[^:'"`])\/\/[^\n]*/g, (m, p1) => p1 + ' '.repeat(m.length - p1.length));
  return out;
}

// Split an argument list on top-level commas only, so a call expression
// carrying its own arguments stays in one piece.
function splitTopLevelArgs(text) {
  const parts = [];
  let depth = 0;
  let current = '';
  let quote = null;
  for (let i = 0; i < text.length; i++) {
    const ch = text[i];
    if (quote) {
      current += ch;
      if (ch === '\\') {
        current += text[++i] || '';
      } else if (ch === quote) {
        quote = null;
      }
      continue;
    }
    if (ch === '"' || ch === "'" || ch === '`') {
      quote = ch;
      current += ch;
      continue;
    }
    if (ch === '(' || ch === '[' || ch === '{') depth++;
    if (ch === ')' || ch === ']' || ch === '}') {
      if (depth === 0) break; // end of the call's argument list
      depth--;
    }
    if (ch === ',' && depth === 0) {
      parts.push(current);
      current = '';
      continue;
    }
    current += ch;
  }
  if (current.trim()) parts.push(current);
  return parts.map((p) => p.trim()).filter(Boolean);
}

// Middleware is a named reference (requireAuth, rateLimiter.strict) or a call
// expression that returns one (express.raw({...}), limiter(60)). The terminal
// handler, written inline as an arrow or function literal, is not middleware.
// Returns the canonical name, or null for inline functions and req/res/next.
function classifyArg(arg) {
  if (/=>/.test(arg) || /^(async\s+)?function\b/.test(arg)) return null;
  const bare = arg.match(/^([A-Za-z_$][\w$.]*)$/);
  if (bare) {
    return ['req', 'res', 'next'].includes(bare[1]) ? null : bare[1];
  }
  const call = arg.match(/^([A-Za-z_$][\w$.]*)\s*\(/);
  if (call) return `${call[1]}(...)`;
  return null;
}

function parseMiddlewareList(argsTail) {
  const out = [];
  for (const arg of splitTopLevelArgs(argsTail)) {
    const name = classifyArg(arg);
    if (name) out.push(name);
  }
  return out;
}

function scanFile(file, root) {
  const source = stripComments(fs.readFileSync(file, 'utf8'));
  const rel = (path.relative(root, file) || path.basename(file)).replace(/\\/g, '/');
  const result = { routes: [], mounts: [], parsers: [], requires: {} };

  let match;

  REQUIRE_NAME_RE.lastIndex = 0;
  while ((match = REQUIRE_NAME_RE.exec(source)) !== null) {
    result.requires[match[1]] = match[3];
  }

  PARSER_RE.lastIndex = 0;
  while ((match = PARSER_RE.exec(source)) !== null) {
    result.parsers.push({
      file: rel,
      line: lineOf(source, match.index),
      kind: `express.${match[1]}`,
      _idx: match.index,
      _arg: 0
    });
  }

  // app.use / router.use, in every arity: bare middleware, prefixed mounts,
  // and mounts carrying several targets. One entry per named target, in
  // argument order; a mount whose only handler is inline still emits one
  // entry, because prefix coverage matters for mount order.
  USE_RE.lastIndex = 0;
  while ((match = USE_RE.exec(source)) !== null) {
    const args = splitTopLevelArgs(source.slice(USE_RE.lastIndex));
    if (args.length === 0) continue;
    let prefix = '(all paths)';
    let rest = args;
    const quoted = args[0].match(/^(['"`])([^'"`]*)\1$/);
    if (quoted) {
      prefix = quoted[2];
      rest = args.slice(1);
    }
    const targets = rest.map(classifyArg).filter(Boolean);
    if (targets.length === 0) targets.push('(inline handler)');
    targets.forEach((target, argPosition) => {
      result.mounts.push({
        file: rel,
        line: lineOf(source, match.index),
        owner: match[1],
        prefix,
        target,
        targetFile: result.requires[target.split('.')[0]] || null,
        _idx: match.index,
        _arg: argPosition
      });
    });
  }

  ROUTE_RE.lastIndex = 0;
  while ((match = ROUTE_RE.exec(source)) !== null) {
    const argsTail = source.slice(ROUTE_RE.lastIndex);
    result.routes.push({
      file: rel,
      line: lineOf(source, match.index),
      owner: match[1],
      method: match[2].toUpperCase(),
      path: match[4],
      middlewares: parseMiddlewareList(argsTail),
      _idx: match.index,
      _arg: 0
    });
  }

  return result;
}

// Source order, exactly: file (code-unit compare, locale-independent), then
// character position of the match, then argument position for the entries a
// single multi-target call fans out into.
function bySourcePosition(a, b) {
  if (a.file !== b.file) return a.file < b.file ? -1 : 1;
  if (a._idx !== b._idx) return a._idx - b._idx;
  return a._arg - b._arg;
}

function stripInternal(entry) {
  const { _idx, _arg, ...clean } = entry;
  return clean;
}

function main() {
  const root = path.resolve(process.argv[2] || '.');
  if (!fs.existsSync(root)) {
    console.error(`third-rail-route-map: no such directory: ${root}`);
    process.exit(1);
  }

  const files = listJsFiles(root);
  const routes = [];
  const mounts = [];
  const parsers = [];

  for (const file of files) {
    try {
      const scanned = scanFile(file, root);
      routes.push(...scanned.routes);
      mounts.push(...scanned.mounts);
      parsers.push(...scanned.parsers);
    } catch (err) {
      console.error(`third-rail-route-map: skipped ${file}: ${err.message}`);
    }
  }

  routes.sort(bySourcePosition);
  mounts.sort(bySourcePosition);
  parsers.sort(bySourcePosition);

  const output = {
    root,
    scannedFiles: files.length,
    ordering: 'parsers, mounts, and routes are each in source order within their file; cross-file order is path order, not execution order (see limitations)',
    parsers: parsers.map(stripInternal),
    mounts: mounts.map(stripInternal),
    routes: routes.map(stripInternal),
    limitations: [
      'Regex-based static scan: misses dynamic route registration, computed path strings, and middleware passed as a spread array.',
      'Route-shaped text inside string literals (docs, fixtures, multi-line templates) will appear in the map; comments are stripped, strings are not. A visible false positive beats a silently dropped route.',
      'Middleware chains are read from the route declaration onward; a chain assembled across multiple statements before the route is registered will be incomplete.',
      'A regex literal containing a quote character can desync argument splitting for that one call, truncating its reported chain.',
      'Mount-to-file resolution follows simple const-require patterns only.',
      'Ordering within a file is reliable. Ordering ACROSS files is alphabetical by path, not execution order, so a parser mounted in one file and a router in another cannot be sequenced from this output alone.',
      'Treat this map as a starting inventory to verify with Read and Grep, not as proof of absence.'
    ]
  };

  process.stdout.write(JSON.stringify(output, null, 2) + '\n');
}

main();
