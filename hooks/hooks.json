{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard.js",
            "timeout": 10,
            "statusMessage": "third-rail: checking sensitive paths"
          }
        ]
      }
    ]
  }
}
